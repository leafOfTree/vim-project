# Terminal settings of every tape. render.sh puts them at the top of each
# tape: VHS sizes the terminal before running Source, so they can't be sourced
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 720
Set Padding 16
Set Framerate 24
Set PlaybackSpeed 1.4
Set TypingSpeed 35ms
Set Theme "Catppuccin Mocha"
